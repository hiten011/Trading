# =============================================================================
# docker compose settings  ->  copy to  .env
# =============================================================================
# These control HOW the containers run. Actual secrets live in
# secrets/.env.dev (see secrets/.env.dev.example).
# =============================================================================

# ---- Upstream PKScreener image -----------------------------------------------
# Published by the PKScreener project on Docker Hub.
PKSCREENER_IMAGE=pkjmesra/pkscreener
PKSCREENER_TAG=latest

# ---- Timezone (India) --------------------------------------------------------
TZ=Asia/Kolkata

# ---- One-shot scan (`docker compose run --rm screener`) -----------------------
# Menu path in MainMenu:Index:Scanner form.
#   X   = Scanners
#   12  = "Nifty (All Stocks)"  <- every listed Indian stock PKScreener tracks
#   23  = "Breaking out now"
# Other useful indexes: 5 = Nifty 500, 14 = F&O stocks only
# Other useful scanners: 5 = RSI, 6 = Reversal signals, 7 = Chart patterns,
#                        9 = Volume gainers, 31 = High momentum (RSI/MFI/CCI)
SCAN_OPTIONS=X:12:23

# ---- Custom alert runner (our own indicator) ---------------------------------
# Which stocks to evaluate:
#   auto        - every symbol present in PKScreener's cached data (all of NSE)
#   pkscreener  - ask PKScreener's fetcher for index PKS_INDEX_OPTION
#   file        - read config/universe.txt (one symbol per line)
PKS_UNIVERSE=auto

# Used when PKS_UNIVERSE=pkscreener. 12 = Nifty (All Stocks), 5 = Nifty 500.
PKS_INDEX_OPTION=12

# Candles handed to your indicator (trading days of history).
PKS_LOOKBACK_DAYS=250

# A --schedule container refreshes its own market-data cache periodically
# (no separate data-refresh container or external cron needed) -- this is
# what keeps it useful running unattended on a server for weeks. Only
# applies to --schedule; --once (e.g. `make dry-run`) never auto-refreshes,
# so testing an indicator stays fast.
PKS_AUTO_REFRESH_DATA=1
# Refresh once the newest cache file is at least this many hours old.
PKS_DATA_MAX_AGE_HOURS=20

# Liquidity / price sanity filters applied BEFORE your indicator runs.
PKS_MIN_PRICE=20
PKS_MAX_PRICE=100000
PKS_MIN_AVG_VOLUME=100000

# Cap on how many hits go into one Telegram alert (0 = no cap).
PKS_MAX_ALERTS=40

# When to run. Times are IST, 24h, comma separated. Empty = run once and exit.
# Example below: shortly after the NSE close, and again pre-open.
PKS_RUN_AT=15:45,09:05

# Alternative to PKS_RUN_AT: run every N minutes (0 = disabled).
PKS_INTERVAL_MINUTES=0

# Only run on NSE trading days (Mon-Fri). Set to 0 to also run on weekends.
PKS_TRADING_DAYS_ONLY=1

# Set to 1 to print alerts to stdout instead of sending them to Telegram.
PKS_DRY_RUN=0

# Send a "scan finished, 0 matches" note even when nothing matched.
PKS_NOTIFY_EMPTY=0

# Attach the full result table as a CSV document alongside the message.
PKS_ATTACH_CSV=1

# Which strategy module to load from custom/strategies/ (without .py).
# Swap this to run a different indicator without touching any other file.
PKS_STRATEGY=my_indicator

# Log verbosity: DEBUG, INFO, WARNING, ERROR
PKS_LOG_LEVEL=INFO

# =============================================================================
# F&O option open-interest blast scanner  (docker compose up -d oi-scanner)
# =============================================================================
# Separate from the equity screener above -- different data source, different
# schedule, different container. Full explanation of every knob and what the
# backtest said about it: docs/OI_SCANNER.md
#
# Data comes from NSE's official end-of-day F&O bhavcopy archive: free, no
# account, complete (all ~215 F&O underlyings), history back to July 2024.
# One trading session is the finest resolution available from it.

# Where option data comes from. 'bhavcopy' is the only one that works
# unattended; 'nselive' needs an IP NSE does not throttle (see docs).
OI_SOURCE=bhavcopy

# ---- Tiered thresholds (% OI change vs the previous session) ----------------
OI_WATCH_PCT=300
OI_STRONG_PCT=1000
OI_EXTREME_PCT=2000
# Only alert at or above this tier: WATCH, STRONG or EXTREME.
OI_MIN_TIER=STRONG

# ---- Absolute floors, all in LOTS ------------------------------------------
# Bhavcopy quotes open interest in shares, so these are normalised by lot size
# -- otherwise a floor would compare IDEA (lot 71,475) with RELIANCE (lot 500)
# and exclude the wrong one.
OI_MIN_OI_LOTS=500
# Yesterday's OI floor. This is what kills "10 contracts became 110 = +1000%".
OI_MIN_PREV_OI_LOTS=50
# The addition itself has to be material, not just the percentage.
OI_MIN_DELTA_OI_LOTS=250
OI_MIN_VOLUME_LOTS=100
# Traded rupee value, in crore. Comparable across a Rs.100 and a Rs.40,000 stock.
OI_MIN_NOTIONAL_CR=1

# ---- Near the money ---------------------------------------------------------
# Deep OTM strikes swing enormous percentages on a handful of lots.
OI_MAX_MONEYNESS_PCT=10

# ---- Expiry hygiene ---------------------------------------------------------
# Expiry-week OI is dominated by mechanical unwinding, not conviction.
OI_MIN_DTE=2
OI_MAX_DTE=45
# Only the nearest N expiries; far series have thin base OI that manufactures
# huge percentages.
OI_MAX_EXPIRIES=2
# Before a monthly expiry, OI migrates wholesale into the next series. That is
# position transfer, not new conviction, so the far month is dropped for a few
# sessions. Costs you alerts around expiry; that is the intended trade-off.
OI_SUPPRESS_ROLLOVER=1
OI_ROLLOVER_WINDOW_DAYS=5

# ---- Significance -----------------------------------------------------------
# The OI added, as a fraction of that symbol's entire option OI book.
OI_MIN_SHARE_OF_SYMBOL_OI=0.005
# Per-contract z-score gate: how unusual is this move *for this contract*.
# 0 disables it. Above 0 makes each scan read ~20 extra sessions.
OI_MIN_Z_SCORE=0
OI_Z_LOOKBACK=20
# Contracts whose position appeared from zero today. Their percentage is
# undefined rather than infinite, so they are graded on absolute size.
OI_INCLUDE_NEW_CONTRACTS=1
# Require the symbol's futures leg to agree with the option's directional read.
OI_REQUIRE_FUTURES_CONFIRM=0

# ---- Alerting ---------------------------------------------------------------
OI_MAX_ALERTS=25
# Stops one stock in the middle of a rollover filling the whole message.
OI_MAX_PER_SYMBOL=3
# Hours before the same contract may alert again. An escalation to a higher
# tier bypasses this, because that is new information.
OI_COOLDOWN_HOURS=12
# IST. NSE publishes the F&O bhavcopy around 18:00-19:00, so anything earlier
# scans the previous session.
OI_RUN_AT=18:30
OI_INTERVAL_MINUTES=0
OI_TRADING_DAYS_ONLY=1
OI_DRY_RUN=0
OI_NOTIFY_EMPTY=0
OI_ATTACH_CSV=1
OI_LOG_LEVEL=INFO

# Restrict the scan to specific underlyings (empty = all ~215).
OI_SYMBOLS=
# Indices (NIFTY, BANKNIFTY...) have weekly expiries and hedging-dominated OI.
OI_EXCLUDE_INDICES=0

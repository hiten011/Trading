# =============================================================================
# PKScreener secrets file  ->  copy to  secrets/.env.dev  and fill in
# =============================================================================
# This file is read by PKScreener itself (PKDevTools.classes.Environment) AND by
# our custom alert runner. It is mounted read-only into the containers at
# /PKScreener-main/.env.dev
#
# NEVER commit the filled-in version. secrets/.env.dev is in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED for Telegram alerts
# -----------------------------------------------------------------------------

# Bot token from @BotFather. Looks like: 8123456789:AAF-xxxxxxxxxxxxxxxxxxxxxxxxxxx
TOKEN=''

# Where scan results are delivered.
# Your personal Telegram numeric user id (get it from @userinfobot), OR a
# channel/group id. This is the chat our custom alerts are sent to.
chat_idADMIN=''

# PKScreener's own "channel" id, used by its --bot / --barometer modes.
# NOTE THE QUIRK: PKScreener prepends a "-" to whatever you put here.
#   channel id -1001785195297  ->  put  1001785195297  here
# Our custom runner handles both forms, so you can also just repeat
# chat_idADMIN's value if you are not using a channel.
CHAT_ID=''

# -----------------------------------------------------------------------------
# OPTIONAL - leave blank unless you need the feature
# -----------------------------------------------------------------------------

# Only needed if you want PKScreener to trigger GitHub workflows for data
# downloads (upstream feature, not needed for local scans).
GITHUB_TOKEN=''
CI_PAT=''

# Upstream premium/broker integrations. Not required for local screening.
TURSO_TOKEN=''
KTOKEN=''
KUSER=''
KPWD=''
KTOTP=''
DB_TYPE=''
DB_TICKS=''
SUBSCRIPTION_ENABLED='0'

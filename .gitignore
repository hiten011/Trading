# ---- Credentials ----
# .env and secrets/.env.dev are INTENTIONALLY committed in this repo (owner's
# explicit choice, repo is public) so the setup works with zero configuration
# after cloning. Don't reflexively re-add them here -- see secrets/.env.dev
# for the rationale.
*.pem
*.key

# ---- Runtime data / outputs ----
# The directories themselves are tracked (they are docker bind-mount targets);
# everything downloaded into them is not.
data/**
!data/results/
!data/results/.gitkeep
!data/actions-data-download/
!data/actions-data-download/.gitkeep
/results/
*.pkl
*.log
logs/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
